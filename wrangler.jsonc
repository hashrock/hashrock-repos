{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hashrock-repos",
	"main": "./dist/index.js",
	"compatibility_date": "2026-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// hashrock.info ゾーン上のカスタムドメイン。DNS レコードは wrangler が作成する。
	"routes": [
		{
			"pattern": "repos.hashrock.info",
			"custom_domain": true
		}
	],
	// カスタムドメインへ移行済みのため workers.dev は無効化
	"workers_dev": false,
	"assets": {
		"directory": "./dist"
	},
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "hashrock-repos-images"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hashrock-repos-db",
			"database_id": "a8f5ed42-3464-4556-b33b-d958f07a130d",
			"migrations_dir": "drizzle/migrations"
		}
	]
}