{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hashrock-repos",
	"main": "./dist/index.js",
	"compatibility_date": "2026-02-14",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// hashrock.info ゾーン上のルート。repos.hashrock.info のプロキシ済み DNS レコードはダッシュボードで作る
	// (wrangler は作らない)。証明書は Universal (*.hashrock.info) を使う。
	"routes": [
		{
			"pattern": "repos.hashrock.info/*",
			"zone_name": "hashrock.info"
		}
	],
	// repos.hashrock.info で公開しているため workers.dev は無効化
	"workers_dev": false,
	"assets": {
		"directory": "./dist"
	},
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "hashrock-repos-images"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hashrock-repos-db",
			"database_id": "a8f5ed42-3464-4556-b33b-d958f07a130d",
			"migrations_dir": "drizzle/migrations"
		}
	],
	// サインアップ数を集めるサービス (JSON 文字列)。各サービスの GET /api/stats を叩く。
	// url が null のものは本番 URL が未記入 (取得せず「URL 未設定」と表示)。
	// Bearer トークンは secret の STATS_TOKEN (wrangler secret put STATS_TOKEN)。
	"vars": {
		"STATS_SOURCES": "[{\"name\":\"edane\",\"url\":\"https://edane.hashrock.info\"},{\"name\":\"ganttpad-cf\",\"url\":\"https://ganttpad.app\"},{\"name\":\"grid24\",\"url\":\"https://grid.hashrock.info\"},{\"name\":\"jam\",\"url\":\"https://jam.hashrock.info\"},{\"name\":\"nansuka\",\"url\":\"https://nansuka.hashrock.info\"},{\"name\":\"homupe\",\"url\":\"https://homupe.dev\"}]"
	},
	// 毎日 UTC 0 時にサインアップ数のスナップショットを取る (app/server.ts の scheduled)
	"triggers": {
		"crons": ["0 0 * * *"]
	}
}